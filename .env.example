# Application
PORT=3000

# SMTP (used by sendEmail)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=supersecret
FROM_EMAIL=no-reply@example.com
FROM_NAME="My Service"

# SendGrid (optional)
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
SENDGRID_FROM_EMAIL=no-reply@example.com

# Database / DB connection (if used)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=email_db
DB_USER=dbuser
DB_PASS=dbpass
